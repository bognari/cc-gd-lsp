{
  "gdscript": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/bin/godot-lsp-bridge.js"],
    "extensionToLanguage": {
      ".gd": "gdscript",
      ".gdshader": "gdshader",
      ".gdshaderinc": "gdshader"
    },
    "transport": "stdio",
    "startupTimeout": 45000,
    "shutdownTimeout": 5000,
    "maxRestarts": 3
  },
  "godot-resource": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/bin/godot-resource-lsp.js"],
    "extensionToLanguage": {
      ".tscn": "godot-resource",
      ".tres": "godot-resource"
    },
    "transport": "stdio",
    "startupTimeout": 10000,
    "shutdownTimeout": 3000,
    "maxRestarts": 3
  }
}
